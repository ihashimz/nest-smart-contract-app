# Local development database and JWT signing secret
DATABASE_URL=postgresql://app:change-me@localhost:5432/options_db
JWT_SECRET=
JWT_EXPIRES_IN=24h
PORT=3000
NODE_ENV=development
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Explicit local administrator bootstrap; remove password after seeding
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_BANK_NAME=
SEED_BANK_CODE=
SEED_BANK_ADDRESS=

# Experimental adapter is disabled by default; use disposable test assets only
ENABLE_EXPERIMENTAL_TRANSFERS=false
BLOCKCHAIN_RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
CHAIN_ID=137
